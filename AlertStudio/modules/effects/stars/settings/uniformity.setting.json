{
  "id": "uniformity",
  "type": "number",
  "default": 35,
  "min": 0,
  "max": 100,
  "step": 1,
  "unit": "%",
  "animatable": true,
  "label": {
    "ru": "Равномерность по краю",
    "en": "Rim uniformity"
  },
  "group": {
    "id": "link",
    "label": {
      "ru": "Связь с облаком",
      "en": "Cloud attachment"
    }
  },
  "when": {
    "key": "fieldMode",
    "equals": "cloud",
    "and": [
      {
        "key": "cloudDistribution",
        "equals": "contour"
      }
    ]
  }
}
