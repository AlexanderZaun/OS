{
  "id": "cloudRotation",
  "type": "number",
  "default": 0,
  "min": -180,
  "max": 180,
  "step": 1,
  "unit": "°",
  "animatable": true,
  "label": {
    "ru": "Поворот относительно облака",
    "en": "Cloud relative rotation"
  },
  "group": {
    "id": "link",
    "label": {
      "ru": "Связь с облаком",
      "en": "Cloud attachment"
    }
  },
  "when": {
    "key": "fieldMode",
    "equals": "cloud"
  }
}
